MAILJET_SECRET_KEY=
RESEND_API_KEY=
EMAIL_CODE_PEPPER=
SESSION_SIGNING_KEY=
TURNSTILE_SECRET_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
GIF_PROVIDER_API_KEY=

# ---- workers/gateway : secrets ----
SESSION_SIGNING_KEY=
HANGCORD_KEK_V1=

# ---- workers/storage-router : secrets ----
FIRESTORE_SA_JSON=
CSV_ROUTINE_KEY=
CSV_EMERGENCY_PUBLIC_KEY_V1=
