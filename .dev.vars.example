# Copy to .dev.vars next to each Worker's wrangler config for local development (git-ignored).
# NAMES ONLY — never commit values. Production values: `npx wrangler secret put <NAME> --env prod` (owner only).
# Full register with owners, storage and rotation: docs/SECRETS_AND_SENSITIVE_DATA.md

# ---- workers/api : secrets ----
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_ADMIN_SA_JSON=
FIRESTORE_SA_JSON=
