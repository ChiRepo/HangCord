{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HangCord",
  "version": "0.0.1",
  "identifier": "app.hangcord.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev -w apps/web",
      "cwd": "../../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build -w apps/web",
      "cwd": "../../.."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HangCord",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Better place to hang out.",
    "longDescription": "HangCord \u2014 a free, lightweight, privacy-respecting hangout app. Beta: things may load slowly or glitch while we build.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
