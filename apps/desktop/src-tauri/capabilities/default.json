{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only event listening + HangCord's own commands. No path, fs, shell, HTTP, menu or window APIs; the webview cannot emit events.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-cache-get",
    "allow-cache-put",
    "allow-cache-delete",
    "allow-cache-keys",
    "allow-cache-wipe",
    "allow-governor-status",
    "allow-set-lightweight",
    "allow-app-info",
    "allow-auth-status",
    "allow-auth-password",
    "allow-auth-google",
    "allow-auth-cancel",
    "allow-auth-logout",
    "allow-api-request",
    "allow-gateway-connect",
    "allow-gateway-send",
    "allow-gateway-disconnect"
  ]
}
